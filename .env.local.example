# Airtable Personal Access Token, scoped to data.records:read + schema.bases:read.
# Shared across all offers; base IDs and table IDs live in src/lib/airtable/tables*.ts.
AIRTABLE_PAT=

# Google service account credentials (Sheets API, read-only), used by Rippy.
# Setup: Google Cloud Console -> enable "Google Sheets API" -> IAM & Admin ->
# Service Accounts -> create one -> Keys -> Add Key (JSON) -> copy client_email
# and private_key below. Then share each Rippy Google Sheet (Sales Team EOD,
# EOC Report, Base44 Closes) with that service account's email as a Viewer.
# Sheet IDs live in src/lib/google-sheets/tables-rippy.ts.
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
